---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { getUpcomingEvents, getPastEvents } from "../lib/sanity";

let upcoming: any[] = [];
let past: any[] = [];

const projectId = import.meta.env.PUBLIC_SANITY_PROJECT_ID;
if (projectId && projectId !== "your_project_id_here") {
  [upcoming, past] = await Promise.all([getUpcomingEvents(), getPastEvents()]);
}

function formatDate(iso: string) {
  const d = new Date(iso + "T00:00:00");
  return {
    day: String(d.getUTCDate()).padStart(2, "0"),
    mon: d.toLocaleDateString("en-GB", { month: "short", timeZone: "UTC" }),
    monAr: d.toLocaleDateString("ar-EG", { month: "short", timeZone: "UTC" }),
    ym: iso.slice(0, 7),
  };
}
---

<Layout title="Events — IMHPR">
  <Nav />

  <section class="bg-ink px-8 py-20">
    <div class="mx-auto max-w-7xl">
      <p class="mb-4 text-xs font-bold tracking-widest uppercase text-paper/40">
        <span class="en">Calendar</span>
        <span class="fr">Calendrier</span>
        <span class="ar">التقويم</span>
      </p>
      <h1 class="text-[13vw] md:text-[9vw] font-black leading-none tracking-tighter text-paper uppercase">
        <span class="en block">Events</span>
        <span class="fr block">Événements</span>
        <span class="ar block">الفعاليات</span>
      </h1>
    </div>
  </section>

  <!-- Upcoming -->
  <section class="bg-paper px-8 py-24">
    <div class="mx-auto max-w-7xl">
      <div class="mb-4 flex items-center justify-between">
        <h2 class="text-xs font-bold tracking-widest uppercase text-muted">
          <span class="en">Upcoming Events</span>
          <span class="fr">Événements à venir</span>
          <span class="ar">الفعاليات القادمة</span>
        </h2>
        <p class="text-xs text-muted">
          <span class="en">Registration via president@imhp-rights.org</span>
          <span class="fr">Inscription via president@imhp-rights.org</span>
          <span class="ar">التسجيل عبر president@imhp-rights.org</span>
        </p>
      </div>

      {upcoming.length === 0 ? (
        <div class="border-t border-line py-20 text-center">
          <p class="text-sm text-muted">
            <span class="en">No upcoming events at this time.</span>
            <span class="fr">Aucun événement à venir pour le moment.</span>
            <span class="ar">لا توجد فعاليات قادمة في الوقت الحالي.</span>
          </p>
        </div>
      ) : (
        <div class="space-y-0">
          {upcoming.map((ev) => {
            const d = formatDate(ev.eventDate);
            return (
              <div class="border-t border-line py-8 flex flex-col gap-4 md:flex-row md:gap-10">
                <div class="flex items-center gap-3 md:w-24 md:flex-col md:items-start md:gap-0 shrink-0">
                  <span class="text-4xl font-black leading-none text-ink">{d.day}</span>
                  <span class="text-xs font-bold tracking-widest uppercase text-muted">
                    <span class="en">{d.mon}</span>
                    <span class="ar">{d.monAr}</span>
                  </span>
                </div>
                <div class="flex-1">
                  <div class="mb-2 flex items-center gap-3">
                    <span class="rounded-sm bg-paper-dim px-2 py-0.5 text-xs font-bold tracking-wide text-muted">
                      <span class="en">{ev.tag}</span>
                      <span class="fr">{ev.tag}</span>
                      <span class="ar">{ev.tagAr ?? ev.tag}</span>
                    </span>
                  </div>
                  <h3 class="mb-2 text-lg font-bold leading-snug text-ink">
                    <span class="en">{ev.title}</span>
                    <span class="fr">{ev.title}</span>
                    <span class="ar">{ev.titleAr ?? ev.title}</span>
                  </h3>
                  {(ev.body || ev.bodyAr) && (
                    <p class="mb-3 text-sm leading-relaxed text-muted">
                      <span class="en">{ev.body}</span>
                      <span class="fr">{ev.body}</span>
                      <span class="ar">{ev.bodyAr ?? ev.body}</span>
                    </p>
                  )}
                  <div class="flex flex-wrap gap-x-6 gap-y-1 text-xs text-muted">
                    {ev.location && (
                      <span>
                        <span class="en">{ev.location}</span>
                        <span class="fr">{ev.location}</span>
                        <span class="ar">{ev.locationAr ?? ev.location}</span>
                      </span>
                    )}
                    {ev.time && <span>{ev.time}</span>}
                    {ev.access && (
                      <span class="font-semibold">
                        <span class="en">{ev.access}</span>
                        <span class="fr">{ev.access}</span>
                        <span class="ar">{ev.accessAr ?? ev.access}</span>
                      </span>
                    )}
                  </div>
                  {ev.registrationUrl && (
                    <a
                      href={ev.registrationUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="mt-3 inline-block text-xs font-bold tracking-widest uppercase text-accent hover:underline"
                    >
                      <span class="en">Register →</span>
                      <span class="fr">S'inscrire →</span>
                      <span class="ar">← التسجيل</span>
                    </a>
                  )}
                </div>
              </div>
            );
          })}
          <div class="border-t border-line"></div>
        </div>
      )}
    </div>
  </section>

  <!-- Past -->
  {past.length > 0 && (
    <section class="bg-paper-dim px-8 py-24">
      <div class="mx-auto max-w-7xl">
        <h2 class="mb-0 text-xs font-bold tracking-widest uppercase text-muted">
          <span class="en">Past Events</span>
          <span class="fr">Événements passés</span>
          <span class="ar">الفعاليات السابقة</span>
        </h2>
        <div class="space-y-0">
          {past.map((ev) => {
            const d = formatDate(ev.eventDate);
            return (
              <div class="border-t border-line py-6 flex items-start gap-8">
                <span class="text-xs font-bold tracking-widest text-muted w-20 shrink-0">{d.ym}</span>
                <div class="flex-1">
                  <span class="mb-1 block text-xs font-bold tracking-wide text-muted">
                    <span class="en">{ev.tag}</span>
                    <span class="fr">{ev.tag}</span>
                    <span class="ar">{ev.tagAr ?? ev.tag}</span>
                  </span>
                  <p class="text-sm font-semibold text-ink">
                    <span class="en">{ev.title}</span>
                    <span class="fr">{ev.title}</span>
                    <span class="ar">{ev.titleAr ?? ev.title}</span>
                  </p>
                  {ev.location && (
                    <p class="text-xs text-muted mt-0.5">
                      <span class="en">{ev.location}</span>
                      <span class="fr">{ev.location}</span>
                      <span class="ar">{ev.locationAr ?? ev.location}</span>
                    </p>
                  )}
                </div>
                {ev.participants && (
                  <span class="text-xs text-muted shrink-0">
                    <span class="en">{ev.participants}</span>
                    <span class="ar">{ev.participantsAr ?? ev.participants}</span>
                  </span>
                )}
              </div>
            );
          })}
          <div class="border-t border-line"></div>
        </div>
      </div>
    </section>
  )}

  <Footer />
</Layout>
