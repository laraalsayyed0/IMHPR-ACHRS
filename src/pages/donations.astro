---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const donations = [
  { id: "DON-2025-089", date: "2025-10-15", en: { name: "Anonymous" },               ar: { name: "مجهول الهوية" }, amount: "CHF 500",  campaign: { en: "General Fund",           ar: "الصندوق العام" },           status: "success" },
  { id: "DON-2025-088", date: "2025-10-12", en: { name: "Sara Al-Khalidi" },          ar: { name: "سارة الخالدي" }, amount: "USD 150",  campaign: { en: "Education Programme",    ar: "برنامج التعليم" },          status: "failed"  },
  { id: "DON-2025-087", date: "2025-10-10", en: { name: "Markus Frei" },              ar: { name: "ماركوس فري" },   amount: "EUR 1,000",campaign: { en: "Legal Aid Fund",         ar: "صندوق المساعدة القانونية" },status: "success" },
  { id: "DON-2025-086", date: "2025-10-08", en: { name: "Rania Mansour" },            ar: { name: "رانيا منصور" },  amount: "USD 75",   campaign: { en: "Emergency Relief",       ar: "الإغاثة الطارئة" },         status: "success" },
  { id: "DON-2025-085", date: "2025-10-05", en: { name: "Anonymous" },               ar: { name: "مجهول الهوية" }, amount: "CHF 200",  campaign: { en: "General Fund",           ar: "الصندوق العام" },           status: "failed"  },
  { id: "DON-2025-084", date: "2025-10-01", en: { name: "Lena Brandt" },              ar: { name: "لينا براندت" },  amount: "EUR 350",  campaign: { en: "Research & Documentation",ar: "البحث والتوثيق" },         status: "success" },
  { id: "DON-2025-083", date: "2025-09-28", en: { name: "Omar Haddad" },              ar: { name: "عمر حداد" },     amount: "JOD 100",  campaign: { en: "Education Programme",    ar: "برنامج التعليم" },          status: "success" },
  { id: "DON-2025-082", date: "2025-09-25", en: { name: "Anonymous" },               ar: { name: "مجهول الهوية" }, amount: "USD 500",  campaign: { en: "Legal Aid Fund",         ar: "صندوق المساعدة القانونية" },status: "failed"  },
  { id: "DON-2025-081", date: "2025-09-22", en: { name: "Fatima Al-Nasser" },        ar: { name: "فاطمة الناصر" }, amount: "CHF 100",  campaign: { en: "Emergency Relief",       ar: "الإغاثة الطارئة" },         status: "success" },
  { id: "DON-2025-080", date: "2025-09-18", en: { name: "Jean-Pierre Morel" },       ar: { name: "جان-بيير موريل" },amount:"EUR 2,500",campaign: { en: "General Fund",           ar: "الصندوق العام" },           status: "success" },
];

const total    = donations.length;
const successes = donations.filter(d => d.status === "success").length;
const failures  = donations.filter(d => d.status === "failed").length;
---

<Layout title="Donation History — IMHPR">
  <Nav />

  <!-- Page header -->
  <section class="bg-ink px-8 py-20">
    <div class="mx-auto max-w-7xl">
      <p class="mb-4 text-xs font-bold tracking-widest uppercase text-paper/40">
        <span class="en">Transparency</span>
        <span class="ar">الشفافية</span>
      </p>
      <h1 class="text-[11vw] md:text-[8vw] font-black leading-none tracking-tighter text-paper uppercase">
        <span class="en block">Donation<br>History</span>
        <span class="ar block text-[7vw]">سجل<br>التبرعات</span>
      </h1>
    </div>
  </section>

  <!-- Summary stats -->
  <section class="bg-paper-dim border-b border-line px-8 py-10">
    <div class="mx-auto max-w-7xl">
      <div class="grid grid-cols-3 divide-x divide-line">
        <div class="px-6 first:ps-0">
          <p class="text-3xl font-black text-ink">{total}</p>
          <p class="mt-1 text-xs font-bold tracking-widest uppercase text-muted">
            <span class="en">Total Donations</span>
            <span class="ar">إجمالي التبرعات</span>
          </p>
        </div>
        <div class="px-6">
          <p class="text-3xl font-black" style="color:#1a7a3f">{successes}</p>
          <p class="mt-1 text-xs font-bold tracking-widest uppercase text-muted">
            <span class="en">Successful</span>
            <span class="ar">ناجحة</span>
          </p>
        </div>
        <div class="px-6">
          <p class="text-3xl font-black" style="color:#b91c1c">{failures}</p>
          <p class="mt-1 text-xs font-bold tracking-widest uppercase text-muted">
            <span class="en">Failed</span>
            <span class="ar">فاشلة</span>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Filter bar -->
  <section class="bg-paper border-b border-line px-8 py-4 sticky top-[57px] z-40">
    <div class="mx-auto max-w-7xl flex items-center gap-4">
      <span class="text-xs font-bold tracking-widest uppercase text-muted">
        <span class="en">Filter:</span>
        <span class="ar">تصفية:</span>
      </span>
      <button data-filter="all"     class="filter-btn active-filter rounded-sm px-3 py-1.5 text-xs font-bold tracking-widest uppercase transition-colors">
        <span class="en">All</span><span class="ar">الكل</span>
      </button>
      <button data-filter="success" class="filter-btn rounded-sm px-3 py-1.5 text-xs font-bold tracking-widest uppercase transition-colors">
        <span class="en">Successful</span><span class="ar">ناجحة</span>
      </button>
      <button data-filter="failed"  class="filter-btn rounded-sm px-3 py-1.5 text-xs font-bold tracking-widest uppercase transition-colors">
        <span class="en">Failed</span><span class="ar">فاشلة</span>
      </button>
    </div>
  </section>

  <!-- Donations list -->
  <section class="bg-paper px-8 py-16">
    <div class="mx-auto max-w-7xl">

      <!-- Table header -->
      <div class="hidden md:grid md:grid-cols-[1fr_1.5fr_1fr_1fr_120px] gap-4 mb-0 text-xs font-bold tracking-widest uppercase text-muted">
        <span><span class="en">Reference</span><span class="ar">المرجع</span></span>
        <span><span class="en">Donor</span><span class="ar">المتبرع</span></span>
        <span><span class="en">Campaign</span><span class="ar">الحملة</span></span>
        <span><span class="en">Amount</span><span class="ar">المبلغ</span></span>
        <span class="text-end"><span class="en">Status</span><span class="ar">الحالة</span></span>
      </div>

      <div id="donationList" class="space-y-0">
        {donations.map((d) => (
          <div
            class="donation-row border-t border-line py-5 flex flex-col gap-2 md:grid md:grid-cols-[1fr_1.5fr_1fr_1fr_120px] md:items-center md:gap-4"
            data-status={d.status}
          >
            <!-- Reference + date -->
            <div>
              <p class="text-xs font-bold text-ink" dir="ltr">{d.id}</p>
              <p class="text-xs text-muted">{d.date}</p>
            </div>

            <!-- Donor -->
            <p class="text-sm font-semibold text-ink">
              <span class="en">{d.en.name}</span>
              <span class="ar">{d.ar.name}</span>
            </p>

            <!-- Campaign -->
            <p class="text-xs text-muted">
              <span class="en">{d.campaign.en}</span>
              <span class="ar">{d.campaign.ar}</span>
            </p>

            <!-- Amount -->
            <p class="text-sm font-bold text-ink" dir="ltr">{d.amount}</p>

            <!-- Status badge -->
            <div class="md:text-end">
              {d.status === "success" ? (
                <span class="inline-flex items-center gap-1.5 rounded-sm px-3 py-1 text-xs font-bold tracking-wide" style="background:#dcfce7;color:#15803d">
                  <span>&#10003;</span>
                  <span class="en">Success</span><span class="ar">ناجح</span>
                </span>
              ) : (
                <span class="inline-flex items-center gap-1.5 rounded-sm px-3 py-1 text-xs font-bold tracking-wide" style="background:#fee2e2;color:#b91c1c">
                  <span>&#10007;</span>
                  <span class="en">Failed</span><span class="ar">فاشل</span>
                </span>
              )}
            </div>
          </div>
        ))}
        <div class="border-t border-line"></div>
      </div>

      <!-- Empty state -->
      <div id="emptyState" class="hidden border-t border-line py-16 text-center">
        <p class="text-sm text-muted">
          <span class="en">No donations match this filter.</span>
          <span class="ar">لا توجد تبرعات تطابق هذا الفلتر.</span>
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-ink px-8 py-16">
    <div class="mx-auto max-w-7xl flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="text-3xl font-black leading-none tracking-tighter text-paper uppercase">
          <span class="en">Support Our Work</span>
          <span class="ar">ادعم عملنا</span>
        </h2>
        <p class="mt-3 text-sm text-paper/50">
          <span class="en">Every contribution helps us defend human rights across borders.</span>
          <span class="ar">كل مساهمة تساعدنا على الدفاع عن حقوق الإنسان عبر الحدود.</span>
        </p>
      </div>
      <a href="/#donate" class="shrink-0 border border-paper px-6 py-3 text-xs font-bold tracking-widest uppercase text-paper hover:bg-paper hover:text-ink transition-colors">
        <span class="en">Donate Now</span>
        <span class="ar">تبرع الآن</span>
      </a>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .filter-btn { color: var(--color-muted); }
  .filter-btn:hover { color: var(--color-ink); }
  .active-filter { background: var(--color-ink); color: var(--color-paper) !important; }
</style>

<script>
  const buttons = document.querySelectorAll(".filter-btn");
  const rows    = document.querySelectorAll<HTMLElement>(".donation-row");
  const empty   = document.getElementById("emptyState");

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      buttons.forEach((b) => b.classList.remove("active-filter"));
      btn.classList.add("active-filter");

      const filter = (btn as HTMLElement).dataset.filter || "all";
      let visible = 0;
      rows.forEach((row) => {
        const show = filter === "all" || row.dataset.status === filter;
        row.style.display = show ? "" : "none";
        if (show) visible++;
      });
      empty?.classList.toggle("hidden", visible > 0);
    });
  });
</script>
