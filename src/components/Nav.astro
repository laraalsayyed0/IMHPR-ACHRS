---
const { pathname } = Astro.url;

const links = [
  { href: "/about",         en: "About",   ar: "من نحن",    fr: "À propos" },
  { href: "/news",          en: "News",    ar: "الأخبار",   fr: "Actualités" },
  { href: "/events",        en: "Events",  ar: "الفعاليات", fr: "Événements" },
  { href: "/application",   en: "Apply",   ar: "انضم الينا", fr: "Rejoindre" },
  { href: "/organizations", en: "Network", ar: "الشبكة",   fr: "Réseau" },
  { href: "/contact",       en: "Contact", ar: "تواصل",    fr: "Contact" },
];

function isActive(href: string) {
  return pathname === href || pathname.startsWith(href + "/");
}
---

<!-- Desktop nav -->
<nav class="fixed top-0 z-50 w-full border-b border-line bg-paper/95 backdrop-blur-sm">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-8 py-4">

    <a href="/" class="flex items-center gap-3 hover:opacity-80 transition-opacity">
      <img src="/images/logo.png" alt="IMHPR logo" class="h-12 w-auto" style="filter: invert(1);" />
      <div class="flex flex-col leading-tight">
        <span class="text-sm font-black tracking-wide text-ink uppercase">IMHPR</span>
        <span class="text-[9px] font-medium tracking-wide text-muted uppercase hidden md:block" style="max-width: 180px; line-height: 1.3;">International Movement for Human and Peoples' Rights</span>
      </div>
    </a>

    <!-- Desktop links -->
    <ul class="hidden items-center gap-8 md:flex">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              "text-xs font-bold tracking-widest uppercase transition-colors",
              isActive(link.href) ? "text-accent" : "text-muted hover:text-ink",
            ]}
          >
            <span class="en">{link.en}</span>
            <span class="ar">{link.ar}</span>
            <span class="fr">{link.fr}</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-6">
      <div class="hidden items-center gap-3 md:flex" style="font-family:'Amiri',serif;">
        <button data-set-lang="en" class="text-sm font-medium text-muted transition-colors hover:text-ink">EN</button>
        <button data-set-lang="fr" class="text-sm font-medium text-muted transition-colors hover:text-ink">FR</button>
        <button data-set-lang="ar" class="text-sm font-medium text-muted transition-colors hover:text-ink">AR</button>
      </div>

      <!-- Mobile hamburger -->
      <button data-nav-toggle class="flex flex-col gap-1.5 md:hidden" aria-label="Menu">
        <span class="block h-px w-6 bg-ink"></span>
        <span class="block h-px w-6 bg-ink"></span>
        <span class="block h-px w-4 bg-ink"></span>
      </button>
    </div>

  </div>

  <!-- Mobile menu -->
  <div id="mobileMenu" class="hidden border-t border-line bg-paper px-8 pb-6 pt-4 md:hidden">
    <ul class="mb-5 space-y-4">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              "block text-sm font-bold tracking-widest uppercase",
              isActive(link.href) ? "text-accent" : "text-muted",
            ]}
          >
            <span class="en">{link.en}</span>
            <span class="ar">{link.ar}</span>
            <span class="fr">{link.fr}</span>
          </a>
        </li>
      ))}
    </ul>
    <div class="flex items-center gap-3" style="font-family:'Amiri',serif;">
      <button data-set-lang="en" class="text-sm font-medium text-muted hover:text-ink">EN</button>
      <button data-set-lang="fr" class="text-sm font-medium text-muted hover:text-ink">FR</button>
      <button data-set-lang="ar" class="text-sm font-medium text-muted hover:text-ink">AR</button>
    </div>
  </div>
</nav>

<!-- Spacer so content starts below fixed nav -->
<div class="h-[57px]"></div>
